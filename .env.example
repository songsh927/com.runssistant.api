# Database
DATABASE_URL=postgresql+asyncpg://runcoach:runcoach@localhost:5432/runcoach
DATABASE_URL_TEST=postgresql+asyncpg://runcoach:runcoach@localhost:5432/runcoach_test

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# LLM Provider (ollama | bedrock | openai)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Bedrock (production)
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_REGION=us-east-1

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Weather
OWM_API_KEY=your-openweathermap-api-key
